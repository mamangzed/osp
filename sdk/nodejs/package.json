{
  "name": "@owl/osp-sdk",
  "version": "0.1.0",
  "description": "Node.js SDK for OSP (Owl Sync Protocol)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate:proto": "node scripts/generate-proto.js",
    "build": "npm run generate:proto && tsc && cp src/osp_pb.js dist/ && cp src/osp_pb.d.ts dist/",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": ["osp", "sync", "realtime", "offline-first", "protobuf"],
  "author": "OWL Team",
  "license": "MIT",
  "dependencies": {
    "uuid": "^9.0.0",
    "protobufjs": "^7.2.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.0.0",
    "protobufjs-cli": "^1.1.2",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  },
  "files": [
    "dist/**/*",
    "proto/**/*",
    "README.md"
  ]
}
